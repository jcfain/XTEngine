{
  "name": "xtp-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "set-version": "node scripts/set-build-version.js",
    "build": "npm run set-version && ng build",
    "deploy": "npm run set-version && ng build --configuration production && rm -f ../www/*.js && rm -f ../www/*.css && rm -f ../www/*.html && cp -r dist/xtp-web/browser/* ../www/ && cd /home/jay/git/XTPlayer && bash deploy-debug-www.sh",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "js-sha3": "^0.13.0",
    "rxjs": "~7.8.0",
    "three": "^0.170.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@types/three": "^0.170.0",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "nice-napi@1.0.2": true,
    "@parcel/watcher@2.6.0": true,
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true
  }
}
